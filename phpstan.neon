includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # These traits are used only by Livewire single-file pages in resources/views,
        # which PHPStan cannot parse.
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/*
